rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stripe extension (firestore-stripe-payments) collections
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      match /checkout_sessions/{id} { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /subscriptions/{id} { allow read: if request.auth != null && request.auth.uid == uid; }
      match /payments/{id} { allow read: if request.auth != null && request.auth.uid == uid; }
    }
    match /products/{id} { allow read: if true; match /prices/{id} { allow read: if true; } }
    match /{document=**} { allow read, write: if false; }
  }
}
